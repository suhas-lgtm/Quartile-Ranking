# Copy this file to .env and fill in your own values.
#
#     cp .env.example .env
#
# .env is gitignored and must stay that way: SUPABASE_SERVICE_KEY is a write
# credential, and anyone holding it can overwrite or delete every file the
# dashboard serves.
#
# ONLY TWO VALUES NEED CHANGING: the URL and the key.
# Supabase dashboard -> Project Settings -> API
#   SUPABASE_URL          the "Project URL"
#   SUPABASE_SERVICE_KEY  the "service_role" key, NOT "anon" — the pipeline
#                         writes, so it needs write access
#
# The bucket names below are the defaults in scripts/supabase_store.py and are
# also written into the two proxy configs the browser uses (site/vite.config.ts
# and netlify.toml). Create your buckets with these exact names and those files
# need no edits. Rename one and you must change all three places to match.
#
# Create both buckets as PUBLIC — the website reads them with no credential,
# which is why no key is ever shipped to the browser.
#
#   MF Data         the dashboard's JSON (quartiles, watchlist, meta, indices)
#   Indicies Data   the Market Pulse index files (spelled as shown)

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY
SUPABASE_DATA_BUCKET=MF Data
